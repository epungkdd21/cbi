# ============================================
# CBI Admin System - Environment Configuration
# ============================================
# Copy this file to .env and update values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_USER=cbi_admin
DB_PASS=your_secure_database_password_here
DB_NAME=cbi_database
DB_PORT=3306
DB_CHARSET=utf8mb4

# ============================================
# SECURITY CONFIGURATION
# ============================================

# Encryption key for sensitive data (32+ characters)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_32_chars_or_more

# Session configuration
SESSION_TIMEOUT=1800
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false

# Rate limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900
MAX_API_REQUESTS=100
API_REQUEST_WINDOW=3600

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
SMTP_HOST=mail.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=noreply@culturebridgeindonesia.my.id
SMTP_PASS=your_email_password_here
SMTP_FROM_EMAIL=noreply@culturebridgeindonesia.my.id
SMTP_FROM_NAME=Culture Bridge Indonesia

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_NAME=Culture Bridge Indonesia
APP_URL=https://culturebridgeindonesia.my.id
APP_ENV=production
DEBUG_MODE=false

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp,pdf
UPLOAD_FOLDER=uploads

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_FOLDER=backups

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_ERROR_FILE=logs/error.log
LOG_SECURITY_FILE=logs/security.log
LOG_AUDIT_FILE=logs/audit.log
LOG_MAX_SIZE=10485760

# ============================================
# API CONFIGURATION
# ============================================
API_RATE_LIMIT_ENABLED=true
API_CORS_ENABLED=false
API_CORS_ORIGINS=https://trusted-domain.com

# ============================================
# PAYMENT GATEWAY (For Event Registration)
# ============================================
PAYMENT_GATEWAY=bank_transfer
BANK_NAME=Bank Central Asia
BANK_ACCOUNT_NAME=Culture Bridge Indonesia
BANK_ACCOUNT_NUMBER=1234567890
BANK_ROUTING_NUMBER=022

# Midtrans (if using Midtrans for payment gateway)
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_ENVIRONMENT=production

# ============================================
# TWO-FACTOR AUTHENTICATION (Future)
# ============================================
TWO_FACTOR_ENABLED=false
TWO_FACTOR_PROVIDER=totp

# ============================================
# THIRD-PARTY SERVICES
# ============================================

# Google Analytics
GOOGLE_ANALYTICS_ID=

# Recaptcha
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Sentry Error Tracking
SENTRY_ENABLED=false
SENTRY_DSN=

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_TTL=3600

# ============================================
# TIMEZONE
# ============================================
TIMEZONE=Asia/Jakarta

# ============================================
# NOTES
# ============================================
# 1. NEVER commit this file to version control
# 2. Use strong passwords (20+ characters recommended)
# 3. Rotate keys periodically
# 4. Use HTTPS in production
# 5. Keep sensitive values secure
# 6. Review security.log regularly
